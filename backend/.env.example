# Copy to .env and fill in. Never commit .env.

# Required for the AI features (commands, camera and screen reading, speech recognition).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides (defaults picked by measured latency):
# GEMINI_MODEL=gemini-3.5-flash-lite        # commands, screen reading, speech (~1-3 s)
# GEMINI_VISION_MODEL=gemini-3.6-flash      # camera reading (~6-9 s)

# Alternative: Claude instead of Gemini. Set ANTHROPIC_API_KEY and AI_PROVIDER=claude.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=claude
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Azure Speech (az-AZ) gives Əli a native Azerbaijani voice; when set, it also handles
# speech recognition instead of Gemini. Free tier (F0) is enough for a demo.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=az-AZ-BanuNeural   # or az-AZ-BabekNeural
# AZURE_STT_LANGUAGE=az-AZ

# Network. Default 127.0.0.1 works with `adb reverse tcp:8787 tcp:8787`.
PORT=8787
# HOST=0.0.0.0        # to accept phones on the same Wi-Fi...
# APP_TOKEN=change-me # ...then also set a token and enter it in the app settings
